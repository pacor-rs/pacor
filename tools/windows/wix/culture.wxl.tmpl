<?xml version="1.0" encoding="utf-8"?>
<!--
  Pacor's MSI localization template, rendered once per locale configured in
  `[app.i18n]`. `light` is given exactly one of these per run, so each locale
  produces its own MSI: passing several localization files for one output makes
  `light` report duplicate identifiers (LGHT0100).

  `Culture` must be a WiX/.NET culture name (`Locale::as_wix_culture`); the
  strings WixUI itself displays (Welcome, Next, …) are localized by the
  extension and are not listed here.

  `Codepage` is the package's string code page. It belongs on this element
  rather than on `Product`, because one `main.wxs` is linked with a different
  localization per locale. Windows Installer stores every string in that single
  code page, so text outside it fails the build with `LGHT0311` — code page 936
  has no `©`, for instance. Set `msi_codepage` in `pacor.toml` when a project
  really needs characters its locale's code page lacks.
-->
<WixLocalization Culture="{{CULTURE}}" Codepage="{{MSI_CODEPAGE}}" xmlns="http://schemas.microsoft.com/wix/2006/localization">
    <String Id="ProductName">{{APP_DISPLAY_NAME}}</String>
    <String Id="Manufacturer">{{APP_PUBLISHER}}</String>
    <String Id="ProductDescription">{{APP_DESCRIPTION}}</String>
    <String Id="LegalCopyright">{{APP_COPYRIGHT}}</String>
    <String Id="FeatureMain">{{FEATURE_MAIN}}</String>
    <String Id="UninstallShortcut">{{UNINSTALL_SHORTCUT}}</String>
    <String Id="DowngradeError">{{DOWNGRADE_ERROR}}</String>
</WixLocalization>
